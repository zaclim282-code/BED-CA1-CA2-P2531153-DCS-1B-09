{
  "name": "student-assignment-template",
  "version": "1.0.0",
  "description": "Base template for ST0503 BED using Express.js, libsql, and Drizzle ORM",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --config _extras/nodemon.json index.js",
    "db": "node src/db/seed.js",
    "test": "vitest run --reporter=dot --silent=passed-only",
    "test:watch": "vitest",
    "export": "zip -r export.zip . -x 'node_modules/*' 'export.zip'"
  },
  "dependencies": {
    "@libsql/client": "^0.15.0",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.38.0",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0",
    "vitest": "^3.2.4"
  },
  "keywords": [],
  "author": "larrythng96",
  "license": "ISC"
}
